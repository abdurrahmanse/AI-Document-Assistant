{
  "extends": "@workspace/typescript-config/base.json",
  "compilerOptions": {
    "module": "Preserve",
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "website/**/*", "app/**/*", "admin/**/*"],
  "exclude": ["node_modules"]
}
