# ==============================================================================
# Turborepo Monorepo - .gitignore
# Contains ignores for Node/Next.js (Frontend), Python/FastAPI (Backend), and Tooling
# ==============================================================================

# =========================
# Node & Tooling
# =========================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# =========================
# Turborepo
# =========================
.turbo
turbo*.log

# =========================
# Next.js & Frontend
# =========================
.next/
out/
build/
dist/
.contentlayer
next-env.d.ts
*.tsbuildinfo

# =========================
# Python & Backend (FastAPI / uv / Ruff)
# =========================
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Testing & Type-Checking & Linting
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
*.cover
*.log

# =========================
# Environment Variables
# =========================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# DO NOT IGNORE .env.example

# =========================
# Operating System
# =========================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# =========================
# IDEs & Editors
# =========================
.idea/
.project
.classpath
*.launch
.settings/
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/

# =========================
# Miscellaneous
# =========================
coverage/
tmp/
*.swp
*.bak

# =========================
# Enterprise Caches & Tools
# =========================
.vercel/
.cursorrules
.eslintcache
*.tsbuildinfo
