    "check-types": "turbo run check-types",
    "prepare": "husky"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.10.11",
    "typescript": "5.9.2",
    "husky": "^9.1.5",
    "lint-staged": "^15.2.10"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
