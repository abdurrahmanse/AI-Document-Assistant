{
  "name": "ai-document-intelligence",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "kill-port 3000 3001 3002 8000 || true && turbo run dev",
    "lint": "turbo run lint",
    "format": "turbo run format && prettier --write \"**/*.{ts,tsx,js,jsx,md,json,yml}\"",
    "check-types": "turbo run check-types",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.5",
    "kill-port": "^2.0.1",
    "lint-staged": "^15.2.10",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.11",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.33.0"
  }
}
