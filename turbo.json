{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "build/**"],
      "env": [
        "NEXT_PUBLIC_*"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": [".eslintcache", ".ruff_cache/**"]
    },
    "check-types": {
      "dependsOn": ["^check-types"],
      "outputs": ["*.tsbuildinfo", ".mypy_cache/**"]
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": [".pytest_cache/**", "coverage/**", "htmlcov/**"]
    },
    "format": {
      "outputs": []
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
