# ==========================================
# PUBLIC ENVIRONMENT VARIABLES (Safe for frontend)
# Prefix with NEXT_PUBLIC_ for Next.js
# ==========================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:8000"

# ==========================================
# SERVER-ONLY SECRETS (Never expose to frontend)
# ==========================================

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_document_intelligence"

# Authentication
# e.g., NextAuth / Supabase / Clerk secrets
AUTH_SECRET="development-secret-change-in-production"

# AI / External Providers
# OPENAI_API_KEY="sk-..."
